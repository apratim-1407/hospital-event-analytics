# Copy to .env on the server (deploy/setup-vm.sh generates this with random secrets for you).
# Never commit the real file.

# A domain name gives automatic HTTPS. With only an IP address, use <ip-with-dashes>.sslip.io
# (e.g. 203-0-113-7.sslip.io): it resolves to that IP and still gets a real certificate.
# ":80" serves plain HTTP only.
SITE_ADDRESS=:80

POSTGRES_USER=hospital
POSTGRES_DB=hospital
POSTGRES_PASSWORD=
JWT_SECRET=

# Demo accounts (ALLOW_DEMO_SEED=true is the explicit opt-in for hosting a demo)
ALLOW_DEMO_SEED=true
SEED_USERS=true
SEED_ADMIN_EMAIL=admin@hospital.local
SEED_ADMIN_PASSWORD=
SEED_ANALYST_EMAIL=analyst@hospital.local
SEED_ANALYST_PASSWORD=
SEED_VIEWER_EMAIL=viewer@hospital.local
SEED_VIEWER_PASSWORD=

# Tuning (optional)
API_WORKERS=2
WORKER_CONCURRENCY=2
PG_SHARED_BUFFERS=512MB
