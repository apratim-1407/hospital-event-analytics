# Copy to .env and adjust. Everything has a working local default in
# docker-compose.yml, so .env is optional for `docker compose up`.
# NEVER commit a real .env.

ENVIRONMENT=dev
LOG_LEVEL=INFO

POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital
POSTGRES_DB=hospital

# Must be replaced outside dev; the app refuses to start in prod with the default.
JWT_SECRET=change-me-to-a-long-random-string

# Local object storage (MinIO) standing in for S3
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=hospital-events

# Demo accounts created by `scripts.bootstrap` when SEED_USERS=true (dev only)
SEED_USERS=true
SEED_ADMIN_EMAIL=admin@hospital.local
SEED_ADMIN_PASSWORD=Admin#12345
SEED_ANALYST_EMAIL=analyst@hospital.local
SEED_ANALYST_PASSWORD=Analyst#12345
SEED_VIEWER_EMAIL=viewer@hospital.local
SEED_VIEWER_PASSWORD=Viewer#12345
# Ingest API key accepted in the X-API-Key header (stored hashed in the database)
SEED_INGEST_API_KEY=hea_dev_ingest_key_change_me

# Processing tier
WORKER_CONCURRENCY=2
# Seconds before an unacknowledged task from a dead worker is redelivered
CELERY_VISIBILITY_TIMEOUT=45
DB_POOL_SIZE=20
